generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dream {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String
  image       String?    // Optional
  isPublic    Boolean
  tags        String[]   // Required list (non-nullable but can be an empty array)
  userId      String
  mood        String?    // Optional
  emotions    String[]   // Required list (non-nullable but can be an empty array)
  colors      String[]   // Required list (non-nullable but can be an empty array)
  role        Boolean?   // Optional
  people      String[]   // Required list (non-nullable but can be an empty array)
  places      String[]   // Required list (non-nullable but can be an empty array)
  things      String[]   // Required list (non-nullable but can be an empty array)
  user        User      @relation(fields: [userId], references: [id])
  favoritedBy Favorite[]
}

model User {
  id        String   @id @default(uuid())
  auth0Id   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  picture   String?
  createdAt DateTime @default(now())
  dreams    Dream[]
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  dreamId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream     Dream    @relation(fields: [dreamId], references: [id], onDelete: Cascade)
  note      Note?
  @@unique([userId, dreamId])
}

model Note {
  id         String   @id @default(uuid())
  favoriteId String   @unique
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  favorite   Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
}